#!/usr/bin/env bash
# Block commits on main. All work lands through a pull request from a
# change/* branch (usually in a worktree under .worktrees/).
# Humans can bypass in a genuine emergency with --no-verify; agents may not.
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
if [ "$branch" = "main" ]; then
  echo "BLOCKED: direct commits to main are not allowed." >&2
  echo "Create a change branch first, e.g.:" >&2
  echo "  git worktree add .worktrees/<change-id> -b change/<change-id>" >&2
  exit 1
fi
exit 0
