#!/usr/bin/env bash
# Enable GitHub branch protection on main: pull requests required, no force
# pushes, no deletions. Approval count is 0 so a solo maintainer can merge
# their own PRs (GitHub does not let you approve your own PR).
# Requires: gh CLI authenticated, and the repo pushed to GitHub.
# Note: on private repos this needs a paid GitHub plan.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
gh api -X PUT "repos/$repo/branches/main/protection" \
  --input - >/dev/null <<'JSON'
{
  "required_status_checks": null,
  "enforce_admins": false,
  "required_pull_request_reviews": { "required_approving_review_count": 0 },
  "restrictions": null,
  "allow_force_pushes": false,
  "allow_deletions": false
}
JSON
echo "branch protection enabled on $repo:main (PRs required)"
